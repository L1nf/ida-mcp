{
  "name": "ida-mcp",
  "version": "20261008.0.1",
  "description": "Official Hex-Rays IDA MCP Server for DeepSeek Harness (DSH).",
  "mcpServers": {
    "ida": {
      "command": "uv",
      "args": [
        "run",
        "--no-dev",
        "--project",
        "${DSH_PLUGIN_ROOT}",
        "ida-mcp",
        "stdio",
        "--agent=dsh"
      ],
      "env": {
        "IDA_MCP_ID": "${IDA_MCP_ID:-}",
        "IDA_MCP_IDLE_TIMEOUT": "${IDA_MCP_IDLE_TIMEOUT:-}",
        "IDAUSR": "${IDAUSR:-}",
        "IDA_NEXUS_STATE_DIR": "${IDA_NEXUS_STATE_DIR:-}",
        "IDA_MCP_STATE_DIR": "${IDA_MCP_STATE_DIR:-}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.*[_:])?ida__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-dev --project ${DSH_PLUGIN_ROOT} ida-mcp hook dsh"
          }
        ]
      }
    ]
  }
}
