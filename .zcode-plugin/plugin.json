{
  "name": "ida-mcp",
  "version": "20261008.0.1",
  "description": "Official Hex-Rays IDA MCP Server.",
  "mcpServers": {
    "ida": {
      "command": "uv",
      "args": [
        "run",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "ida-mcp",
        "stdio",
        "--agent=zcode"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.*[_:])?ida__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-dev --project ${CLAUDE_PLUGIN_ROOT} ida-mcp hook zcode"
          }
        ]
      }
    ]
  }
}
